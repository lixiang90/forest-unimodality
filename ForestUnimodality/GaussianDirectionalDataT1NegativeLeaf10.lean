def cert10 : Certificate₂ := ⟨13, 8, fun i j => (matrix10[i.val]!).getD j.val 0⟩

theorem leaf10_coeff_nonneg : ∀ i j, 0 ≤ cert10.coeff i j := by decide +kernel

theorem leaf10_identity (x y : ℝ) :
    evalReal₂ compact (((1/4) : ℝ) + ((1/2) - (1/4)) * x)
      (((3/4) : ℝ) + (1 - (3/4)) * y) = value₂ cert10 x y := by
  dsimp only [value₂, cert10]
  norm_num [compact, value₂, cert10, matrix10, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert10, matrix10, Nat.choose]
  ring

theorem leaf10_nonneg : ∀ x ∈ Set.Icc ((1/4) : ℝ) (1/2),
    ∀ y ∈ Set.Icc ((3/4) : ℝ) 1, 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/4) (1/2) (3/4) 1 cert10 (by norm_num) (by norm_num)
    leaf10_coeff_nonneg (by simpa using leaf10_identity) (by simpa using hx) (by simpa using hy)
#print axioms leaf10_nonneg

