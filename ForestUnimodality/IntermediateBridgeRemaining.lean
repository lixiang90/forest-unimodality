theorem proved_counts : provedRectangles.length=896 ∧ provedParents.length=130 ∧
    provedRectangles.Nodup ∧ provedParents.Nodup := by
  refine ⟨by decide +kernel, by decide +kernel, ?_, ?_⟩
  · apply nodup_of_adjacent_nat_rank (fun p : CellKey => p.1 * 1000 + p.2)
    decide +kernel
  · apply nodup_of_adjacent_nat_rank (fun p : Fin 130 => p.val)
    decide +kernel

theorem rectangles_of_remaining (hr : RemainingRectangles.{u}) : RectanglesValid.{u} := by
  intro i hi
  by_cases h : i∈provedRectangles
  · exact proved_rectangles_valid i h
  · exact hr i hi h

theorem parents_of_remaining (hp : RemainingParents.{u}) : ParentsValid.{u} := by
  intro i
  by_cases h : i∈provedParents
  · exact proved_parents_valid i h
  · exact hp i h

theorem completeTarget_of_remaining (hp : RemainingParents.{0})
    (hr : RemainingRectangles.{0}) : CompleteTarget :=
  completeTarget_of_domains (parents_of_remaining hp) (rectangles_of_remaining hr)

