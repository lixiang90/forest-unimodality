theorem scalar_valid : ScalarValid ⟨36, by decide⟩ parameters
    profile0 profile1 source0 source1 tilt0 tilt1 := by
  constructor
  all_goals first | exact rate0_valid | exact rate1_valid | skip
  all_goals try norm_num [parameters, Stage350SourceTable.row, qLower, qUpper,
    ProfileRange, profile0, profile1, source0, source1, tilt0, tilt1,
    GradientProfile.constant, BinomialGradientTable.scale,
    BinomialGradientTable.generalConstant, AffineSourceLibrary.domain, AffineSourceData.Case15.domain]

variable {V : Type*} [DecidableEq V]

theorem actual_inputs {G : SimpleGraph V} {S B : Finset V} {z : ℝ} (k : ℕ)
    (hB : IsMaximumMarginalIndependentOn G S B z) (hG : G.IsAcyclic)
    (hn : 350 ≤ S.card) (hz : z ∈ Set.Icc parameters.a parameters.b)
    (hrank : (S.card : ℝ)/4 ≤ hardCoreMean G S z)
    (hmean : hardCoreMean G S z = (k : ℝ)) :
    DirectionBudgetGraph.Inputs parameters G S B z (hardCoreAvailableMean G S B z)
      k profile0 profile1 :=
  Stage350PlainDirectionInputs.actual_inputs ⟨36, by decide⟩ parameters parameters_valid
    profile0 profile1 source0 source1 tilt0 tilt1 scalar_valid k hB hG hn hz hrank hmean

