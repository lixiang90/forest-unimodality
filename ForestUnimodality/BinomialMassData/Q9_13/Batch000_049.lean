    lowerValues := #[10000000000000000000000000000000000000000]
    upperValues := #[10000000000000000000000000000000000000000] }

theorem walk_checked : table.walkCheck 9 13=true := by decide +kernel

theorem checked : table.check 9 13=true := by
  have hw : table.WalkValid 9 13 := of_decide_eq_true walk_checked
