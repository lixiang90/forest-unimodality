namespace ForestUnimodality.BinomialMassData.Q11_21.Degree000
def table : IntegerTable 0 :=
  { pivot := 0
    denominator := 10000000000000000000000000000000000000000
    lowerValues := #[10000000000000000000000000000000000000000]
    upperValues := #[10000000000000000000000000000000000000000] }

theorem walk_checked : table.walkCheck 11 21=true := by decide +kernel

theorem checked : table.check 11 21=true := by
  have hw : table.WalkValid 11 21 := of_decide_eq_true walk_checked
  have hv : table.Valid 11 21 := IntegerTable.exactValid_valid (IntegerTable.walkValid_exactValid hw)
  exact decide_eq_true hv

#print axioms walk_checked
#print axioms checked
end ForestUnimodality.BinomialMassData.Q11_21.Degree000

