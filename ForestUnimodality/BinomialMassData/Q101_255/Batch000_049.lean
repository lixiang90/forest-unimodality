set_option maxHeartbeats 0
open ForestUnimodality.BinomialMassIntervalCertificate

namespace ForestUnimodality.BinomialMassData.Q101_255.Degree000
def table : IntegerTable 0 :=
  { pivot := 0
    denominator := 10000000000000000000000000000000000000000
    lowerValues := #[10000000000000000000000000000000000000000]
    upperValues := #[10000000000000000000000000000000000000000] }

theorem walk_checked : table.walkCheck 101 255=true := by decide +kernel

theorem checked : table.check 101 255=true := by
  have hw : table.WalkValid 101 255 := of_decide_eq_true walk_checked
  have hv : table.Valid 101 255 := IntegerTable.exactValid_valid (IntegerTable.walkValid_exactValid hw)
  exact decide_eq_true hv

#print axioms walk_checked
#print axioms checked
end ForestUnimodality.BinomialMassData.Q101_255.Degree000

