    lowerValues := #[10000000000000000000000000000000000000000]
    upperValues := #[10000000000000000000000000000000000000000] }

theorem walk_checked : table.walkCheck 4 9=true := by decide +kernel

theorem checked : table.check 4 9=true := by
  have hw : table.WalkValid 4 9 := of_decide_eq_true walk_checked
