def table : IntegerTable 0 :=
  { pivot := 0
    denominator := 10000000000000000000000000000000000000000
    lowerValues := #[10000000000000000000000000000000000000000]
    upperValues := #[10000000000000000000000000000000000000000] }

theorem walk_checked : table.walkCheck 9 14=true := by decide +kernel

theorem checked : table.check 9 14=true := by
  have hw : table.WalkValid 9 14 := of_decide_eq_true walk_checked
  have hv : table.Valid 9 14 := IntegerTable.exactValid_valid (IntegerTable.walkValid_exactValid hw)
  exact decide_eq_true hv

#print axioms walk_checked
#print axioms checked
end ForestUnimodality.BinomialMassData.Q9_14.Degree000

