set_option maxRecDepth 100000
set_option maxHeartbeats 0
open ForestUnimodality.BinomialMassIntervalCertificate

namespace ForestUnimodality.BinomialMassData.Q1_3.Degree000
def table : IntegerTable 0 :=
  { pivot := 0
    denominator := 10000000000000000000000000000000000000000
    lowerValues := #[10000000000000000000000000000000000000000]
    upperValues := #[10000000000000000000000000000000000000000] }

theorem walk_checked : table.walkCheck 1 3=true := by decide +kernel

theorem checked : table.check 1 3=true := by
  have hw : table.WalkValid 1 3 := of_decide_eq_true walk_checked
  have hv : table.Valid 1 3 := IntegerTable.exactValid_valid (IntegerTable.walkValid_exactValid hw)
  exact decide_eq_true hv

#print axioms walk_checked
#print axioms checked
end ForestUnimodality.BinomialMassData.Q1_3.Degree000

