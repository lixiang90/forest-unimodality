import ForestUnimodality.BinomialMassWalkCertificate

/-! Reusable exact-probability mass intervals, grouped only by q and n.
The data is untrusted until the sequential integral checker is proved true. -/
set_option maxRecDepth 100000
set_option maxHeartbeats 0
open ForestUnimodality.BinomialMassIntervalCertificate

namespace ForestUnimodality.BinomialMassData.Q3_5.Degree000
def table : IntegerTable 0 :=
  { pivot := 0
    denominator := 10000000000000000000000000000000000000000
    lowerValues := #[10000000000000000000000000000000000000000]
    upperValues := #[10000000000000000000000000000000000000000] }

theorem walk_checked : table.walkCheck 3 5=true := by decide +kernel

theorem checked : table.check 3 5=true := by
  have hw : table.WalkValid 3 5 := of_decide_eq_true walk_checked
  have hv : table.Valid 3 5 := IntegerTable.exactValid_valid (IntegerTable.walkValid_exactValid hw)
  exact decide_eq_true hv

#print axioms walk_checked
#print axioms checked
end ForestUnimodality.BinomialMassData.Q3_5.Degree000

