theorem coverage_60 (a k : ℕ) (h : Domain 60 a k) :
    ∃ w : Witness, w.check 60 a k = true := by
  obtain ⟨hnlo, hnhi, halo, hahi, hklo, hkhi⟩ := h
  have haLo : 30 ≤ a := by omega
