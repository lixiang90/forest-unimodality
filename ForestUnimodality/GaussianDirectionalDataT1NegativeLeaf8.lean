def cert8 : Certificate₂ := ⟨13, 8, fun i j => (matrix8[i.val]!).getD j.val 0⟩

theorem leaf8_coeff_nonneg : ∀ i j, 0 ≤ cert8.coeff i j := by decide +kernel

theorem leaf8_identity (x y : ℝ) :
    evalReal₂ compact ((0 : ℝ) + ((1/4) - 0) * x)
      (((3/4) : ℝ) + (1 - (3/4)) * y) = value₂ cert8 x y := by
  dsimp only [value₂, cert8]
  norm_num [compact, value₂, cert8, matrix8, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert8, matrix8, Nat.choose]
  ring

theorem leaf8_nonneg : ∀ x ∈ Set.Icc (0 : ℝ) (1/4),
    ∀ y ∈ Set.Icc ((3/4) : ℝ) 1, 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact 0 (1/4) (3/4) 1 cert8 (by norm_num) (by norm_num)
    leaf8_coeff_nonneg (by simpa using leaf8_identity) (by simpa using hx) (by simpa using hy)
#print axioms leaf8_nonneg

end ForestUnimodality.GaussianDirectionalDataT1Negative
