    ∀ y ∈ Set.Icc (0 : ℝ) (1/4), 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact 0 (1/4) 0 (1/4) cert0 (by norm_num) (by norm_num)
