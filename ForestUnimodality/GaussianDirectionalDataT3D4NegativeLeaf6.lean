def cert6 : Certificate₂ := ⟨13, 8, fun i j => (matrix6[i.val]!).getD j.val 0⟩

theorem leaf6_coeff_nonneg : ∀ i j, 0 ≤ cert6.coeff i j := by decide +kernel

theorem leaf6_identity (x y : ℝ) :
    evalReal₂ compact (((1/4) : ℝ) + ((1/2) - (1/4)) * x)
      (((1/2) : ℝ) + (1 - (1/2)) * y) = value₂ cert6 x y := by
  dsimp only [value₂, cert6]
  norm_num [compact, value₂, cert6, matrix6, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert6, matrix6, Nat.choose]
  ring

theorem leaf6_nonneg : ∀ x ∈ Set.Icc ((1/4) : ℝ) (1/2),
    ∀ y ∈ Set.Icc ((1/2) : ℝ) 1, 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/4) (1/2) (1/2) 1 cert6 (by norm_num) (by norm_num)
    leaf6_coeff_nonneg (by simpa using leaf6_identity) (by simpa using hx) (by simpa using hy)
#print axioms leaf6_nonneg

