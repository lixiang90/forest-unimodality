theorem leaf2_coeff_nonneg : ∀ i j, 0 ≤ cert2.coeff i j := by decide +kernel

theorem leaf2_identity (x y : ℝ) :
    evalReal₂ compact (((3/8) : ℝ) + ((1/2) - (3/8)) * x)
