import ForestUnimodality.TerminalBlockRecurrence

/-! Exact affine certificates for the finite short-bridge context table.
External data supplies multipliers only. Every target and path hypothesis
is recomputed from the proved block recurrence inside the Lean kernel. -/

namespace ForestUnimodality.TerminalContextCertificate

open TerminalBlockRecurrence

abbrev Row := ℚ × ℚ × ℚ × ℚ

def blockRow (s : BlockState ℚ) (d : ℚ) : Row :=
  let C := 60 * s.alpha - 60 * d * s.delta + 29 * s.N
  (60 * s.A, 60 * s.B, 180 * s.MA - C * s.A,
    180 * s.MB - (C + 29 + 60 * d) * s.B)

def eval (a : Row) (X Y r : ℝ) : ℝ := a.1 * X + a.2.1 * Y + a.2.2.1 * r + a.2.2.2

theorem eval_blockRow (s : BlockState ℚ) (d : ℚ) (X Y r : ℝ) :
    eval (blockRow s d) X Y r = E (castState s) d X Y r := by
  simp [eval, blockRow, E, castState, Rat.cast_add, Rat.cast_mul, Rat.cast_sub, Rat.cast_ofNat]
  ring

theorem eval_add (a b : Row) (X Y r : ℝ) :
    eval (a + b) X Y r = eval a X Y r + eval b X Y r := by
  simp only [eval, Prod.fst_add, Prod.snd_add, Rat.cast_add]
  ring

theorem eval_smul (q : ℚ) (a : Row) (X Y r : ℝ) :
    eval (q • a) X Y r = (q : ℝ) * eval a X Y r := by
  simp only [eval, Prod.smul_fst, Prod.smul_snd, smul_eq_mul, Rat.cast_mul]
  ring

def pathState (j : ℕ) : BlockState ℚ := iterate (j - 1) ⟨1, 2, 0, 2, 1, 1, 1⟩

/-- Indices 0..3 are X,Y,r-1,3-r; index j+3 is the j-vertex path. -/
def hypRow (d : ℚ) : ℕ → Row
  | 0 => (1, 0, 0, 0)
  | 1 => (0, 1, 0, 0)
  | 2 => (0, 0, 1, -1)
  | 3 => (0, 0, -1, 3)
  | i + 4 => blockRow (pathState (i + 1)) d

def HypValid (s : BlockState ℚ) (i : ℕ) : Prop :=
  i < 4 ∨ (4 ≤ i ∧ ((i - 3 : ℕ) : ℚ) < s.N)

instance (s : BlockState ℚ) (i : ℕ) : Decidable (HypValid s i) := inferInstanceAs
  (Decidable (i < 4 ∨ (4 ≤ i ∧ ((i - 3 : ℕ) : ℚ) < s.N)))

structure Certificate where
  terms : List (ℕ × ℚ)
  slack : ℚ
  deriving DecidableEq

def combinedRow (d : ℚ) (c : Certificate) : Row :=
  (c.terms.map fun t => t.2 • hypRow d t.1).sum + (0, 0, 0, c.slack)

def certificateCheck (s : BlockState ℚ) (d : ℚ) (c : Certificate) : Bool :=
  decide (0 < c.slack ∧ (∀ t ∈ c.terms, 0 ≤ t.2 ∧ HypValid s t.1) ∧
    blockRow s d = combinedRow d c)

theorem eval_terms_nonneg (s : BlockState ℚ) (d : ℚ) (ts : List (ℕ × ℚ))
    (X Y r : ℝ) (ht : ∀ t ∈ ts, 0 ≤ t.2 ∧ HypValid s t.1)
    (hh : ∀ i, HypValid s i → 0 ≤ eval (hypRow d i) X Y r) :
    0 ≤ eval (ts.map fun t => t.2 • hypRow d t.1).sum X Y r := by
  induction ts with
  | nil => simp [eval]
  | cons t ts ih =>
    simp only [List.map_cons, List.sum_cons, eval_add, eval_smul]
    have ht0 := ht t (by simp)
    have hq : (0 : ℝ) ≤ (t.2 : ℝ) := by exact_mod_cast ht0.1
    exact add_nonneg (mul_nonneg hq (hh t.1 ht0.2))
      (ih (fun u hu => ht u (by simp [hu])))

theorem certificate_sound (s : BlockState ℚ) (d : ℚ) (c : Certificate)
    (hc : certificateCheck s d c = true) (X Y r : ℝ)
    (hh : ∀ i, HypValid s i → 0 ≤ eval (hypRow d i) X Y r) :
    0 < E (castState s) d X Y r := by
  obtain ⟨hslack, hterms, heq⟩ := of_decide_eq_true hc
  rw [← eval_blockRow, heq, combinedRow, eval_add]
  have hs : (0 : ℝ) < (c.slack : ℝ) := by exact_mod_cast hslack
  have ht := eval_terms_nonneg s d c.terms X Y r hterms hh
  simpa only [eval, Rat.cast_zero, zero_mul, zero_add] using add_pos_of_nonneg_of_pos ht hs

theorem hypotheses_nonneg (s : BlockState ℚ) (d : ℚ) (X Y r : ℝ)
    (hX : 0 ≤ X) (hY : 0 ≤ Y) (hrlo : 1 ≤ r) (hrhi : r ≤ 3)
    (hpath : ∀ j : ℕ, 0 < j → (j : ℚ) < s.N →
      0 ≤ E (castState (pathState j)) d X Y r) :
    ∀ i, HypValid s i → 0 ≤ eval (hypRow d i) X Y r := by
  intro i hi
  match i with
  | 0 => simpa [hypRow, eval] using hX
  | 1 => simpa [hypRow, eval] using hY
  | 2 => simpa [hypRow, eval] using (sub_nonneg.mpr hrlo)
  | 3 => simpa [hypRow, eval] using (sub_nonneg.mpr hrhi)
  | i + 4 =>
    have hi' : ((i + 1 : ℕ) : ℚ) < s.N := by
      rcases hi with hi | ⟨_, hi⟩
      · omega
      · simpa only [show i + 4 - 3 = i + 1 by omega] using hi
    simpa only [hypRow, eval_blockRow] using hpath (i + 1) (by omega) hi'

