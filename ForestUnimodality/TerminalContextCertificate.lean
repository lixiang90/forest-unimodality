def certificateFor (legs : List ℕ) (b : ℕ) : Option Certificate :=
  ((witnessTables.lookup legs).getD []).getD (b - 1) none

def isException (legs : List ℕ) (b : ℕ) : Bool :=
  decide (b = 1 ∧ (legs = [3,3] ∨ legs = [5,3]))

def caseCheck (legs : List ℕ) (b : ℕ) : Bool :=
  match certificateFor legs b with
  | none => isException legs b
  | some c => let s := bridgeState legs b; certificateCheck s (1 - s.delta) c

def coverageCheck : Bool := terminalLegs.all fun legs =>
  (List.range 24).all fun j => caseCheck legs (j + 1)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem coverageCheck_eq_true : coverageCheck = true := by decide +kernel

theorem short_bridge_case_checked (legs : List ℕ) (hl : legs ∈ terminalLegs)
    (b : ℕ) (hblo : 1 ≤ b) (hbhi : b ≤ 24) : caseCheck legs b = true := by
  have h := List.all_eq_true.mp coverageCheck_eq_true legs hl
  have h := List.all_eq_true.mp h (b - 1) (List.mem_range.mpr (by omega))
  simpa only [Nat.sub_add_cancel hblo] using h

/-- Every one of the 45 x 24 cases has a checked strict certificate, apart
from exactly the two bridge-one configurations named in isException. -/
theorem short_bridge_positive (legs : List ℕ) (hl : legs ∈ terminalLegs)
    (b : ℕ) (hblo : 1 ≤ b) (hbhi : b ≤ 24)
    (hne : ¬ (b = 1 ∧ (legs = [3,3] ∨ legs = [5,3])))
    (X Y r : ℝ) (hX : 0 ≤ X) (hY : 0 ≤ Y) (hrlo : 1 ≤ r) (hrhi : r ≤ 3)
    (hpath : ∀ j : ℕ, 0 < j → (j : ℚ) < (bridgeState legs b).N →
      0 ≤ E (castState (pathState j)) ((1 - (bridgeState legs b).delta : ℚ) : ℝ) X Y r) :
    0 < E (castState (bridgeState legs b))
      ((1 - (bridgeState legs b).delta : ℚ) : ℝ) X Y r := by
  have hc := short_bridge_case_checked legs hl b hblo hbhi
  unfold caseCheck at hc
  cases he : certificateFor legs b with
  | none => simp only [he, isException, decide_eq_true_eq] at hc; exact (hne hc).elim
  | some c =>
    rw [he] at hc
    exact certificate_sound _ _ c hc X Y r
      (hypotheses_nonneg _ _ X Y r hX hY hrlo hrhi hpath)

theorem short_bridge_positive_real_state (legs : List ℕ) (hl : legs ∈ terminalLegs)
    (b : ℕ) (hblo : 1 ≤ b) (hbhi : b ≤ 24)
    (hne : ¬ (b = 1 ∧ (legs = [3,3] ∨ legs = [5,3])))
    (X Y r : ℝ) (hX : 0 ≤ X) (hY : 0 ≤ Y) (hrlo : 1 ≤ r) (hrhi : r ≤ 3)
    (hpath : ∀ j : ℕ, 0 < j → (j : ℝ) < (castState (bridgeState legs b)).N →
      0 ≤ E (castState (pathState j)) (1 - (castState (bridgeState legs b)).delta) X Y r) :
    0 < E (castState (bridgeState legs b))
      (1 - (castState (bridgeState legs b)).delta) X Y r := by
  have hp : ∀ j : ℕ, 0 < j → (j : ℚ) < (bridgeState legs b).N →
      0 ≤ E (castState (pathState j)) ((1 - (bridgeState legs b).delta : ℚ) : ℝ) X Y r := by
    intro j hj hjN
    have hjN' : (j : ℝ) < (castState (bridgeState legs b)).N := by
      dsimp only [castState]
      exact_mod_cast hjN
    simpa only [castState, Rat.cast_sub, Rat.cast_one] using hpath j hj hjN'
  simpa only [castState, Rat.cast_sub, Rat.cast_one] using
    short_bridge_positive legs hl b hblo hbhi hne X Y r hX hY hrlo hrhi hp

theorem short_bridge_coverage_count : terminalLegs.length * 24 = 1080 := by
  rw [terminalLegs_length]

def presentWitnesses : List Certificate := witnessTables.flatMap fun row => row.2.filterMap id

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem witness_method_counts :
    presentWitnesses.length = 1078 ∧
    (presentWitnesses.filter (fun c => c.terms.all (fun t => t.1 < 4))).length = 736 ∧
    (presentWitnesses.filter (fun c => !(c.terms.all (fun t => t.1 < 4)))).length = 342 := by
  decide +kernel

#print axioms certificate_sound
#print axioms hypotheses_nonneg
#print axioms coverageCheck_eq_true
#print axioms short_bridge_positive
#print axioms short_bridge_positive_real_state
#print axioms witness_method_counts

