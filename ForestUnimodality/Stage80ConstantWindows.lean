theorem checked (i : Fin 29) : (window i).check=true := by
  fin_cases i <;> decide +kernel

variable {V : Type*} [DecidableEq V]

theorem actual_total_variance (i : Fin 29) {G : SimpleGraph V} {S B : Finset V} {z : ℝ}
    (hB : IsMaximumMarginalIndependentOn G S B z) (hG : G.IsAcyclic)
    (hz : 0<z) (hq : z/(1+z)∈Set.Icc ((window i).qa:ℝ) ((window i).qb:ℝ)) :
    hardCoreVariance G S z≤
      (z/(1+z)*(1-z/(1+z))+((window i).R*(window i).vmax:ℚ))*
        hardCoreAvailableMean G S B z+0 :=
  (window i).total_variance (checked i) hB hG hz hq

