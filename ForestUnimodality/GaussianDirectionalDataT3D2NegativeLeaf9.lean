def cert9 : Certificate₂ := ⟨13, 8, fun i j => (matrix9[i.val]!).getD j.val 0⟩

theorem leaf9_coeff_nonneg : ∀ i j, 0 ≤ cert9.coeff i j := by decide +kernel

theorem leaf9_identity (x y : ℝ) :
    evalReal₂ compact (((1/4) : ℝ) + ((3/8) - (1/4)) * x)
      (((1/2) : ℝ) + ((5/8) - (1/2)) * y) = value₂ cert9 x y := by
  dsimp only [value₂, cert9]
  norm_num [compact, value₂, cert9, matrix9, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert9, matrix9, Nat.choose]
  ring

theorem leaf9_nonneg : ∀ x ∈ Set.Icc ((1/4) : ℝ) (3/8),
    ∀ y ∈ Set.Icc ((1/2) : ℝ) (5/8), 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/4) (3/8) (1/2) (5/8) cert9 (by norm_num) (by norm_num)
    leaf9_coeff_nonneg (by simpa using leaf9_identity) (by simpa using hx) (by simpa using hy)
