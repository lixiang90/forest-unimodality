def cert14 : Certificate₂ := ⟨13, 8, fun i j => (matrix14[i.val]!).getD j.val 0⟩

theorem leaf14_coeff_nonneg : ∀ i j, 0 ≤ cert14.coeff i j := by decide +kernel

theorem leaf14_identity (x y : ℝ) :
    evalReal₂ compact (((1/2) : ℝ) + (1 - (1/2)) * x)
      (((1/2) : ℝ) + (1 - (1/2)) * y) = value₂ cert14 x y := by
  dsimp only [value₂, cert14]
  norm_num [compact, value₂, cert14, matrix14, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert14, matrix14, Nat.choose]
  ring

theorem leaf14_nonneg : ∀ x ∈ Set.Icc ((1/2) : ℝ) 1,
    ∀ y ∈ Set.Icc ((1/2) : ℝ) 1, 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/2) 1 (1/2) 1 cert14 (by norm_num) (by norm_num)
    leaf14_coeff_nonneg (by simpa using leaf14_identity) (by simpa using hx) (by simpa using hy)
#print axioms leaf14_nonneg

