def cert12 : Certificate₂ := ⟨13, 8, fun i j => (matrix12[i.val]!).getD j.val 0⟩

theorem leaf12_coeff_nonneg : ∀ i j, 0 ≤ cert12.coeff i j := by decide +kernel

theorem leaf12_identity (x y : ℝ) :
    evalReal₂ compact (((1/4) : ℝ) + ((1/2) - (1/4)) * x)
      (((3/4) : ℝ) + (1 - (3/4)) * y) = value₂ cert12 x y := by
  dsimp only [value₂, cert12]
  norm_num [compact, value₂, cert12, matrix12, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert12, matrix12, Nat.choose]
  ring

theorem leaf12_nonneg : ∀ x ∈ Set.Icc ((1/4) : ℝ) (1/2),
    ∀ y ∈ Set.Icc ((3/4) : ℝ) 1, 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/4) (1/2) (3/4) 1 cert12 (by norm_num) (by norm_num)
    leaf12_coeff_nonneg (by simpa using leaf12_identity) (by simpa using hx) (by simpa using hy)
