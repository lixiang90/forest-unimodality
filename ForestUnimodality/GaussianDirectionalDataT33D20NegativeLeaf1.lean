def cert1 : Certificate₂ := ⟨13, 8, fun i j => (matrix1[i.val]!).getD j.val 0⟩

theorem leaf1_coeff_nonneg : ∀ i j, 0 ≤ cert1.coeff i j := by decide +kernel

theorem leaf1_identity (x y : ℝ) :
    evalReal₂ compact (((1/4) : ℝ) + ((3/8) - (1/4)) * x)
      ((0 : ℝ) + ((1/4) - 0) * y) = value₂ cert1 x y := by
  dsimp only [value₂, cert1]
  norm_num [compact, value₂, cert1, matrix1, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert1, matrix1, Nat.choose]
  ring

theorem leaf1_nonneg : ∀ x ∈ Set.Icc ((1/4) : ℝ) (3/8),
    ∀ y ∈ Set.Icc (0 : ℝ) (1/4), 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/4) (3/8) 0 (1/4) cert1 (by norm_num) (by norm_num)
    leaf1_coeff_nonneg (by simpa using leaf1_identity) (by simpa using hx) (by simpa using hy)
