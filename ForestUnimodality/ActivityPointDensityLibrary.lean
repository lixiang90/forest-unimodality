/-- All 106 frozen activity points, uniformly over every finite forest. -/
theorem forest_density (i : Fin 106) {V : Type*} [DecidableEq V]
    (G : SimpleGraph V) (hG : G.IsAcyclic) (S : Finset V) (hn : 8≤S.card) :
    let p:=(certificate i).parameters
    (p.r:ℝ)*S.card+p.h≤hardCoreMean G S p.x :=
  ActivityPointDensity.Certificate.forest_density (valid i) G hG S hn

