theorem leaf3_coeff_nonneg : ∀ i j, 0 ≤ cert3.coeff i j := by decide +kernel

theorem leaf3_identity (x y : ℝ) :
    evalReal₂ compact (((1/4) : ℝ) + ((1/2) - (1/4)) * x)
