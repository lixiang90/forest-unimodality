def cert5 : Certificate₂ := ⟨13, 8, fun i j => (matrix5[i.val]!).getD j.val 0⟩

theorem leaf5_coeff_nonneg : ∀ i j, 0 ≤ cert5.coeff i j := by decide +kernel

theorem leaf5_identity (x y : ℝ) :
    evalReal₂ compact ((0 : ℝ) + ((1/8) - 0) * x)
      (((1/2) : ℝ) + ((3/4) - (1/2)) * y) = value₂ cert5 x y := by
  dsimp only [value₂, cert5]
  norm_num [compact, value₂, cert5, matrix5, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert5, matrix5, Nat.choose]
  ring

theorem leaf5_nonneg : ∀ x ∈ Set.Icc (0 : ℝ) (1/8),
    ∀ y ∈ Set.Icc ((1/2) : ℝ) (3/4), 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact 0 (1/8) (1/2) (3/4) cert5 (by norm_num) (by norm_num)
    leaf5_coeff_nonneg (by simpa using leaf5_identity) (by simpa using hx) (by simpa using hy)
#print axioms leaf5_nonneg

