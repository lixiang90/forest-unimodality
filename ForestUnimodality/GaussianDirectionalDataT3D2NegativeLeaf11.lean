theorem leaf11_coeff_nonneg : ∀ i j, 0 ≤ cert11.coeff i j := by decide +kernel

theorem leaf11_identity (x y : ℝ) :
    evalReal₂ compact (((3/8) : ℝ) + ((1/2) - (3/8)) * x)
      (((1/2) : ℝ) + ((3/4) - (1/2)) * y) = value₂ cert11 x y := by
  dsimp only [value₂, cert11]
  norm_num [compact, value₂, cert11, matrix11, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert11, matrix11, Nat.choose]
  ring

