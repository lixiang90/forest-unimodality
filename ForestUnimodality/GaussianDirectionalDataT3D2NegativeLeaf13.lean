def cert13 : Certificate₂ := ⟨13, 8, fun i j => (matrix13[i.val]!).getD j.val 0⟩

theorem leaf13_coeff_nonneg : ∀ i j, 0 ≤ cert13.coeff i j := by decide +kernel

theorem leaf13_identity (x y : ℝ) :
    evalReal₂ compact (((1/2) : ℝ) + (1 - (1/2)) * x)
      ((0 : ℝ) + ((1/2) - 0) * y) = value₂ cert13 x y := by
  dsimp only [value₂, cert13]
  norm_num [compact, value₂, cert13, matrix13, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert13, matrix13, Nat.choose]
  ring

theorem leaf13_nonneg : ∀ x ∈ Set.Icc ((1/2) : ℝ) 1,
    ∀ y ∈ Set.Icc (0 : ℝ) (1/2), 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/2) 1 0 (1/2) cert13 (by norm_num) (by norm_num)
    leaf13_coeff_nonneg (by simpa using leaf13_identity) (by simpa using hx) (by simpa using hy)
#print axioms leaf13_nonneg

