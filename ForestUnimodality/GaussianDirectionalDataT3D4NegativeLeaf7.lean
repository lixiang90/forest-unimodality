def cert7 : Certificate₂ := ⟨13, 8, fun i j => (matrix7[i.val]!).getD j.val 0⟩

theorem leaf7_coeff_nonneg : ∀ i j, 0 ≤ cert7.coeff i j := by decide +kernel

theorem leaf7_identity (x y : ℝ) :
    evalReal₂ compact (((1/2) : ℝ) + (1 - (1/2)) * x)
      ((0 : ℝ) + ((1/2) - 0) * y) = value₂ cert7 x y := by
  dsimp only [value₂, cert7]
  norm_num [compact, value₂, cert7, matrix7, evalReal₂, eval, evalList,
    liftEvaluation, rationalEvaluation, List.finRange, List.ofFn_succ]
  norm_num [cert7, matrix7, Nat.choose]
  ring

theorem leaf7_nonneg : ∀ x ∈ Set.Icc ((1/2) : ℝ) 1,
    ∀ y ∈ Set.Icc (0 : ℝ) (1/2), 0 ≤ evalReal₂ compact x y := by
  intro x hx y hy
  exact box_nonneg_of_identity compact (1/2) 1 0 (1/2) cert7 (by norm_num) (by norm_num)
    leaf7_coeff_nonneg (by simpa using leaf7_identity) (by simpa using hx) (by simpa using hy)
#print axioms leaf7_nonneg

